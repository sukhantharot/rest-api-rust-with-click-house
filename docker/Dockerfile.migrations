# Dockerfile for running migrations only
FROM rust:1.75-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /usr/src/app

# Copy Cargo files first for better layer caching
COPY Cargo.toml Cargo.lock ./

# Create dummy src/main.rs and src/bin/migrate.rs
RUN mkdir src src/bin && \
    echo "fn main() {}" > src/main.rs && \
    echo "fn main() {}" > src/bin/migrate.rs

# Build dependencies
RUN cargo build --release --bin migrate
RUN rm src/main.rs src/bin/migrate.rs

# Copy actual source code
COPY src ./src

# Build the migration binary
RUN rm -f target/release/deps/migrate*
RUN cargo build --release --bin migrate

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd --create-home --shell /bin/bash --user-group --uid 1000 appuser

# Create app directory
WORKDIR /app

# Copy migration binary from builder stage
COPY --from=builder /usr/src/app/target/release/migrate /app/migrate

# Change ownership
RUN chown appuser:appuser /app/migrate
RUN chmod +x /app/migrate

# Switch to non-root user
USER appuser

# Set environment variables
ENV RUST_LOG=info

# Default command
CMD ["/app/migrate", "help"]
